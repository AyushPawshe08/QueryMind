# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily API Key
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl API Key (optional - bypasses Cloudflare & renders client-side JS into Markdown)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Neon PostgreSQL Database URL (for persistent report history)
DATABASE_URL=postgresql://user:password@ep-your-instance.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key (for signing user session tokens)
JWT_SECRET_KEY=your_jwt_secret_key_here
